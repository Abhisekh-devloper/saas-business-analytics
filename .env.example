# SaaS Business Analytics Platform Environment Variables

# App Settings
DEBUG=True
SECRET_KEY=saas-analytics-secret-key-super-secure-change-in-prod-2026

# Database Settings
# Set DB_ENGINE=postgresql to use PostgreSQL, or leave empty/sqlite for SQLite
DB_ENGINE=sqlite
DB_NAME=saas_analytics
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

